# Database
DATABASE_URL="your-database-connection-string-here"
DIRECT_URL=="your-database-connection-string-here"

# Supabase Storage
SUPABASE_STORAGE_S3_ENDPOINT="your-storage-s3-endpoint-here"
SUPABASE_STORAGE_S3_REGION="your-region-here"
SUPABASE_S3_ACCESS_KEY_ID="your-access-key-id-here"
SUPABASE_S3_SECRET_ACCESS_KEY="your-secret-access-key-here"
SUPABASE_STORAGE_BUCKET="your-bucket-name-here"


# JWT
JWT_SECRET="your-super-secret-jwt-key-here"

# Admin Bootstrap
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# Email Configuration
MAIL_HOST="your-mail-host"
MAIL_PORT="465"
MAIL_USER="your-email@domain.com"
MAIL_PASS="your-email-password"
MAIL_FROM="your-email@domain.com"

# Other environment variables can be added here
