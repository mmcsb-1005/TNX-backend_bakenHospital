generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id                  String                 @id @default(cuid())
  name                String?
  email               String?
  image               String?
  role                UserRole               @default(USER)
  userOrgId           String?                @unique
  password            String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  position            String?
  contactNumber       String?
  departmentId        String?
  designationId       String?
  employmentDate      DateTime?
  gradeId             String?
  approvalAssignments ApprovalUserApprover[]
  formSubmissions     FormSubmission[]
  notifications       Notification[]
  paymentClaims       PaymentClaim[]
  reportingStaffs     StaffProfile[]         @relation("ReportingManager")
  staffProfile        StaffProfile?
  trainingBookmarks   TrainingBookmark[]
  department          Department?            @relation(fields: [departmentId], references: [id])
  designation         Designation?           @relation(fields: [designationId], references: [id])
  grade               Grade?                 @relation(fields: [gradeId], references: [id])
  userAttendances     UserAttendance[]
  requestedTrainings  RequestTraining[]      @relation("RequestParticipant")
  submittedRequests   RequestTraining[]      @relation("RequestTrainingSubmittedBy")
}

model StaffProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  employeeId               String?  @unique
  department               String?
  team                     String?
  skills                   String[]
  bio                      String?
  reportingManagerId       String?
  emergencyContactName     String?
  emergencyContactNumber   String?
  emergencyContactRelation String?
  address                  String?
  alternateEmail           String?
  linkedinProfile          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  reportingManager         User?    @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Training {
  id                String             @id @default(cuid())
  title             String
  organizer         String
  trainingType      TrainingType
  dateTimeStart     DateTime
  dateTimeEnd       DateTime
  duration          String?
  venue             String
  bond              BondType
  category          String?
  typeOfPayment     PaymentType
  budgeted          Boolean
  sponsored         String?
  accommodationCost Decimal?           @db.Decimal(10, 2)
  travelCost        Decimal?           @db.Decimal(10, 2)
  mealCost          Decimal?           @db.Decimal(10, 2)
  trainingMethod    TrainingMethod
  comment           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courseCurriculum  String?
  description       String?
  faqs              String?
  imagePath         String?
  objectives        String?
  qrCodeExpiresAt   DateTime?
  qrCodeGeneratedAt DateTime?
  qrCodeToken       String?            @unique
  source            TrainingSource     @default(ADMIN)
  trainingCost      Decimal?           @db.Decimal(10, 2)
  paymentClaims     PaymentClaim[]
  qrCodes           QrCode[]
  requestTrainings  RequestTraining[]
  bookmarks         TrainingBookmark[]
  attendances       UserAttendance[]
  formLinks         FormTraining[]
}

model QrCode {
  id         String   @id @default(cuid())
  trainingId String
  token      String   @unique
  date       DateTime
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, date])
  @@index([trainingId, expiresAt])
}

model TrainingBookmark {
  id         String   @id @default(cuid())
  userId     String
  trainingId String
  createdAt  DateTime @default(now())
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trainingId])
  @@index([trainingId])
}

model Setting {
  id                         String   @id @default(cuid())
  logoPath                   String?
  primaryColor               String?  @default("#3b82f6")
  secondaryColor             String?  @default("#8b5cf6")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  address                    String?
  companyName                String?
  email                      String?
  newUserNotificationMessage String?  @default("A new user {userName} has registered with email {userEmail}")
  newUserNotificationTitle   String?  @default("New User Registration")
  phoneNumber                String?
  requiredTrainingHours      Int?     @default(40)
  trainingReminderDays       Int?     @default(7)
  attendanceGraceMinutes     Int?     @default(15)
}

model Mail {
  id                String       @id @default(cuid())
  name              String?      @unique
  subject           String?
  body              String?
  mailType          MailType?    @unique
  sendTrigger       SendTrigger?
  daysOffset        Int?
  templateVariables Json?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  userType  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model SystemLicense {
  id           String   @id @default(cuid())
  licenseKey   String   @unique
  issuedTo     String?
  issuedAt     DateTime @default(now())
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  maxUserCount Int?     @default(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Grade {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Department {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  approvalUsers    ApprovalUser[]
  approvalUserDepartments ApprovalUserDepartment[]
  requestTrainings RequestTraining[]
  users            User[]
}

model Designation {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  parentId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  parent      Designation?  @relation("DesignationHierarchy", fields: [parentId], references: [id])
  children    Designation[] @relation("DesignationHierarchy")
  users       User[]
}

model RequestTraining {
  id                   String         @id @default(cuid())
  requestName          String
  requestJustification String?
  trainingId           String?
  proposedTrainingData Json?
  approvalUserId       String?
  currentApprovalLevel Int?
  approvalTrail        Json?
  status               ApprovalStatus @default(PENDING)
  approvedAt           DateTime?
  rejectedAt           DateTime?
  approvalNotes        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  departmentId         String?
  submittedById        String?
  approvalUser         ApprovalUser?  @relation(fields: [approvalUserId], references: [id])
  department           Department?    @relation(fields: [departmentId], references: [id])
  training             Training?      @relation(fields: [trainingId], references: [id])
  participants         User[]         @relation("RequestParticipant")
  submittedBy          User?          @relation("RequestTrainingSubmittedBy", fields: [submittedById], references: [id])
}

model ApprovalUser {
  id                 String                 @id @default(cuid())
  title              String
  description        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  departmentId       String?
  department         Department?            @relation(fields: [departmentId], references: [id])
  approvalUserDepartments ApprovalUserDepartment[]
  approvers          ApprovalUserApprover[]
  requestTrainings   RequestTraining[]
}

model ApprovalUserDepartment {
  id             String       @id @default(cuid())
  approvalUserId String
  departmentId   String
  approvalUser   ApprovalUser @relation(fields: [approvalUserId], references: [id], onDelete: Cascade)
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([approvalUserId, departmentId])
  @@index([departmentId])
}

model ApprovalUserApprover {
  id             String       @id @default(cuid())
  approvalUserId String
  userId         String
  level          Int
  approvalUser   ApprovalUser @relation(fields: [approvalUserId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([approvalUserId, userId])
  @@index([approvalUserId, level])
  @@index([userId, level])
}

model UserAttendance {
  id             String    @id @default(cuid())
  trainingId     String
  userId         String
  attendanceDate DateTime
  isPresent      Boolean   @default(false)
  comment        String?
  scannedAt      DateTime?
  scannedVia     String?   @default("QR_CODE")
  expectedStartAt DateTime?
  isLate          Boolean  @default(false)
  lateMinutes     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  training       Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, attendanceDate])
  @@index([trainingId, attendanceDate])
  @@index([trainingId, isLate])
}

model PaymentClaim {
  id                  String             @id @default(cuid())
  trainingId          String
  userId              String
  amountClaimed       Decimal            @db.Decimal(10, 2)
  amountApproved      Decimal?           @db.Decimal(10, 2)
  paymentStatus       PaymentClaimStatus @default(PENDING)
  receiptPath         String?
  receiptOriginalName String?
  notes               String?
  adminRemarks        String?
  verifiedById        String?
  submittedAt         DateTime           @default(now())
  verifiedAt          DateTime?
  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  training            Training           @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([paymentStatus])
  @@index([submittedAt])
}

model Form {
  id          String           @id @default(cuid())
  title       String
  description String?
  isActive    Boolean          @default(true)
  formType    FormType         @default(CUSTOM)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  fields      FormField[]
  submissions FormSubmission[]
  trainingLinks FormTraining[]
}

model FormTraining {
  id         String   @id @default(cuid())
  formId     String
  trainingId String
  createdAt  DateTime @default(now())
  form       Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([formId, trainingId])
  @@index([trainingId])
  @@index([formId])
}

model FormField {
  id          String    @id @default(cuid())
  formId      String
  label       String
  fieldType   FieldType
  placeholder String?
  required    Boolean   @default(false)
  order       Int
  options     Json?
  validation  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  userId    String?
  responses Json
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([formId])
  @@index([userId])
}

enum UserRole {
  ADMIN
  USER
}

enum TrainingType {
  IN_HOUSE
  EXTERNAL
  ONLINE
}

enum BondType {
  BONDED
  NON_BONDED
}

enum PaymentType {
  HRDCORP
  NONE
}

enum PaymentClaimStatus {
  PENDING
  VERIFIED
  REJECTED
  PAID
}

enum TrainingMethod {
  CASH_IN_ADVANCE
  PAY_AND_CLAIM
}

enum TrainingSource {
  ADMIN
  USER_REQUEST
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  NEW_USER
  TRAINING
  APPROVAL
}

enum MailType {
  PASSWORD_RESET
  WELCOME_USER
  GENERAL_ANNOUNCEMENT
  REQUEST_APPROVAL
}

enum SendTrigger {
  MANUAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FormType {
  EVALUATION
  PRE_POST
  CUSTOM
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  DATE
  SELECT
  RADIO
  CHECKBOX
  FILE
  RATING
  HEADER
  PARAGRAPH
}
